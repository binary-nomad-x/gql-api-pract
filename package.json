{
  "name": "gql-prisma-api",
  "version": "1.0.0",
  "main": "src/index.ts",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:dev": "npx prisma migrate dev",
    "studio": "npx prisma studio",
    "generate": "npx prisma generate",
    "db:reset": "npx prisma migrate reset",
    "seed": "tsx prisma/seed/index.ts",
    "seed:reset": "tsx prisma/seed/index.ts --reset",
    "seed:fresh": "tsx prisma/seed/index.ts --fresh",
    "db:rebuild": "npx prisma migrate reset --force && npm run seed",
    "schema:merge": "tsx scripts/merge-schema.ts",
    "setup": "npm install && npx prisma generate && npx prisma migrate dev && npm run seed"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@faker-js/faker": "^10.4.0",
    "@novu/node": "^2.6.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "graphql": "^16.13.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.7.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
