{
  "name": "gql-prisma-api",
  "version": "1.0.0",
  "main": "src/index.ts",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:dev": "npx prisma migrate dev",
    "studio": "npx prisma studio",
    "generate": "npx prisma generate",
    "db:reset": "npx prisma migrate reset",
    "seed": "tsx prisma/seed.ts",
    "seed:reset": "tsx prisma/seed.ts --reset",
    "seed:fresh": "tsx prisma/seed.ts --fresh",
    "db:rebuild": "npx prisma migrate reset --force && npm run seed",
    "setup": "npm install && npx prisma generate && npx prisma migrate dev && npm run seed"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "apollo-server": "^3.13.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.13.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.7.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
