// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url remove from here and placed in prisma.config.ts
}

// Example model (Aap apna table yahan define karein)
model Specialty {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}