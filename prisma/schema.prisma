generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== User Model ====================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  name      String   @default("")
  age       Int      @default(0)
  password  String
  role      String   @default("USER")
  avatarUrl String   @default("")
  bio       String   @default("")
  phone     String   @default("")
  isVerified Boolean @default(false)
  lastLoginAt DateTime @default(now())
  locale    String   @default("en-US")
  timezone  String   @default("UTC")
  metadata  Json     @default("{}")

  profile        Profile?
  posts          Post[]
  comments       Comment[]
  likes          Like[]
  products       Product[]
  orders         Order[]
  reviews        Review[]
  postViews      PostView[]
  addresses      Address[]
  wishlists      Wishlist[]
  cart           Cart?
  notifications  Notification[]      @relation("UserNotifications")
  sentNotifications Notification[]   @relation("SentNotifications")
  followers      Follow[]            @relation("FollowingRelation")
  following      Follow[]            @relation("FollowerRelation")
  savedPosts     SavedPost[]
  subscriptions  Subscription[]
  conversations  ConversationParticipant[]
  sentMessages   Message[]
  returnRequests ReturnRequest[]
  ticketReplies  TicketReply[]

  createdTickets  SupportTicket[] @relation("CreatedTickets")
  assignedTickets SupportTicket[] @relation("AssignedTickets")
  escalatedTickets SupportTicket[] @relation("EscalatedTickets")

  followedCategories UserCategoryFollow[]
  couponCreations    Coupon[]        @relation("CouponCreator")
  discountCreations  Discount[]      @relation("DiscountCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([username])
  @@index([role])
  @@map("users")
}

// ==================== UserCategoryFollow (new junction) ====================
model UserCategoryFollow {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  notifyOnNew Boolean @default(true)
  followedAt DateTime @default(now())

  @@unique([userId, categoryId])
  @@map("user_category_follows")
}

// ==================== Profile Model ====================
model Profile {
  id        String   @id @default(cuid())
  bio       String   @default("")
  avatar    String   @default("")
  phone     String   @default("")
  address   String   @default("")
  fullName  String   @default("")
  dateOfBirth DateTime @default(now())
  gender    String   @default("")
  occupation String  @default("")
  company   String   @default("")
  website   String   @default("")
  education String   @default("")
  newsletter Boolean @default(true)
  marketingOptIn Boolean @default(true)

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

// ==================== Address Model ====================
model Address {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String   @default("Home")
  street              String
  addressLine2        String   @default("")
  city                String
  state               String   @default("")
  zip                 String
  country             String   @default("US")
  phone               String   @default("")
  deliveryInstructions String  @default("")
  latitude            Float    @default(0)
  longitude           Float    @default(0)
  isDefault           Boolean  @default(false)
  isBilling           Boolean  @default(false)
  contactName         String   @default("")
  contactPhone        String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ==================== Post Model ====================
model Post {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  content     String      @default("")
  excerpt     String      @default("")
  coverImage  String      @default("")
  readingTime Int         @default(1)
  published   Boolean     @default(false)
  isFeatured  Boolean     @default(false)
  isArchived  Boolean     @default(false)
  metaTitle   String      @default("")
  metaDescription String  @default("")
  allowComments Boolean   @default(true)
  viewCount   Int         @default(0)
  likeCount   Int         @default(0)
  commentCount Int        @default(0)
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags        Tag[]       @relation("PostToTag")
  categories  Category[]  @relation("PostToCategory")
  comments    Comment[]
  likes       Like[]
  savedBy     SavedPost[]
  views       PostView[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([authorId])
  @@index([published])
  @@index([slug])
  @@map("posts")
}

// ==================== SavedPost Model ====================
model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  note      String   @default("")
  folder    String   @default("Default")
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@map("saved_posts")
}

// ==================== PostView Model ====================
model PostView {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip        String   @default("")
  referrer  String   @default("")
  userAgent String   @default("")
  country   String   @default("")
  city      String   @default("")
  device    String   @default("")
  browser   String   @default("")
  duration  Int      @default(0)
  viewedAt  DateTime @default(now())

  @@index([postId])
  @@map("post_views")
}

// ==================== Tag Model ====================
model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  color       String   @default("#6366f1")
  icon        String   @default("")
  isFeatured  Boolean  @default(false)
  posts       Post[]   @relation("PostToTag")
  createdAt   DateTime @default(now())

  @@map("tags")
}

// ==================== Category Model ====================
model Category {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  description     String    @default("")
  icon            String    @default("")
  imageUrl        String    @default("")
  displayOrder    Int       @default(0)
  isFeatured      Boolean   @default(false)

  parentId        String?
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[] @relation("CategoryHierarchy")

  posts           Post[]    @relation("PostToCategory")
  products        Product[]
  userFollows     UserCategoryFollow[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([parentId])
  @@map("categories")
}

// ==================== Comment Model ====================
model Comment {
  id         String   @id @default(cuid())
  content    String
  isEdited   Boolean  @default(false)
  isApproved Boolean  @default(true)
  upvotes    Int      @default(0)
  downvotes  Int      @default(0)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies    Comment[] @relation("CommentReplies")
  editedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([authorId])
  @@index([postId])
  @@index([parentId])
  @@map("comments")
}

// ==================== Like Model ====================
model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      String   @default("LIKE")
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@map("likes")
}

// ==================== Follow Model ====================
model Follow {
  id            String   @id @default(cuid())
  followerId    String
  follower      User     @relation("FollowerRelation", fields: [followerId], references: [id], onDelete: Cascade)
  followingId   String
  following     User     @relation("FollowingRelation", fields: [followingId], references: [id], onDelete: Cascade)
  isMutual      Boolean  @default(false)
  notifyOnPost  Boolean  @default(true)
  notifyOnStory Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// ==================== Product Model ====================
model Product {
  id            String         @id @default(cuid())
  name          String
  description   String         @default("")
  price         Float
  stock         Int            @default(0)
  sku           String         @unique
  barcode       String         @default("")
  brand         String         @default("")
  color         String         @default("")
  weight        Float          @default(0)
  dimensions    String         @default("")
  rating        Float          @default(0)
  reviewCount   Int            @default(0)
  soldCount     Int            @default(0)
  minimumStock  Int            @default(0)
  allowBackorder Boolean       @default(false)
  warrantyInfo  String         @default("")
  returnPolicy  String         @default("")
  taxClass      String         @default("standard")
  metaTitle     String         @default("")
  metaDescription String       @default("")
  attributes    Json           @default("{}")
  imageUrl      String         @default("")
  images        ProductImage[]
  isActive      Boolean        @default(true)
  sellerId      String
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  discounts     Discount[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([sellerId])
  @@index([categoryId])
  @@index([sku])
  @@index([brand])
  @@map("products")
}

// ==================== ProductImage Model ====================
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String   @default("")
  isPrimary Boolean  @default(false)
  width     Int      @default(0)
  height    Int      @default(0)
  fileSize  Int      @default(0)
  mimeType  String   @default("image/jpeg")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// ==================== Order Model ====================
model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String      @default("PENDING")
  totalAmount     Float       @default(0)
  subtotal        Float       @default(0)
  taxAmount       Float       @default(0)
  shippingAmount  Float       @default(0)
  discountAmount  Float       @default(0)
  currency        String      @default("USD")
  shippingAddress String      @default("")
  email           String      @default("")
  phone           String      @default("")
  notes           String      @default("")
  source          String      @default("web")
  isGift          Boolean     @default(false)
  giftMessage     String      @default("")
  trackingUrl     String      @default("")
  estimatedDelivery DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String      @default("")
  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payment         Payment?
  refunds         Refund[]
  shipments       Shipment[]
  invoice         Invoice?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

// ==================== OrderItem Model ====================
model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int             @default(1)
  unitPrice      Float
  productName    String          @default("")
  productSku     String          @default("")
  productImage   String          @default("")
  discountAmount Float           @default(0)
  taxAmount      Float           @default(0)
  totalPrice     Float           @default(0)
  returnRequests ReturnRequest[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ==================== Payment Model ====================
model Payment {
  id                  String   @id @default(cuid())
  orderId             String   @unique
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount              Float
  currency            String   @default("USD")
  method              String
  gateway             String   @default("stripe")
  gatewayTransactionId String  @default("")
  status              String   @default("PENDING")
  fee                 Float    @default(0)
  netAmount           Float    @default(0)
  payerEmail          String   @default("")
  payerName           String   @default("")
  billingAddress      String   @default("")
  failureReason       String   @default("")
  refundedAmount      Float    @default(0)
  capturedAmount      Float    @default(0)
  transactionId       String   @unique
  refunds             Refund[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("payments")
}

// ==================== Refund Model ====================
model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount           Float
  currency         String   @default("USD")
  reason           String   @default("")
  reasonDescription String  @default("")
  status           String   @default("PENDING")
  initiatedBy      String   @default("system")
  fee              Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([paymentId])
  @@index([orderId])
  @@map("refunds")
}

// ==================== Review Model ====================
model Review {
  id               String   @id @default(cuid())
  rating           Int
  title            String   @default("")
  content          String   @default("")
  isVerified       Boolean  @default(false)
  isRecommended    Boolean  @default(true)
  helpfulCount     Int      @default(0)
  unhelpfulCount   Int      @default(0)
  pros             Json     @default("[]")
  cons             Json     @default("[]")
  images           Json     @default("[]")
  responseFromSeller String @default("")
  responseDate     DateTime?
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

// ==================== Wishlist Model ====================
model Wishlist {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String         @default("Default")
  description String         @default("")
  isPublic    Boolean        @default(false)
  isDefault   Boolean        @default(true)
  itemCount   Int            @default(0)
  shareCode   String         @default("")
  items       WishlistItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@map("wishlists")
}

// ==================== WishlistItem Model ====================
model WishlistItem {
  id              String   @id @default(cuid())
  wishlistId      String
  wishlist        Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int      @default(1)
  priority        String   @default("MEDIUM")
  priceAtAddition Float    @default(0)
  note            String   @default("")
  createdAt       DateTime @default(now())

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ==================== Cart Model ====================
model Cart {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes      String     @default("")
  subtotal   Float      @default(0)
  total      Float      @default(0)
  currency   String     @default("USD")
  couponCode String     @default("")
  discountAmount Float  @default(0)
  sessionId  String     @default("")
  expiresAt  DateTime?
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("carts")
}

// ==================== CartItem Model ====================
model CartItem {
  id              String   @id @default(cuid())
  cartId          String
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int      @default(1)
  unitPrice       Float    @default(0)
  discountAmount  Float    @default(0)
  totalPrice      Float    @default(0)
  notes           String   @default("")
  isSavedForLater Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ==================== Coupon Model ====================
model Coupon {
  id                String    @id @default(cuid())
  code              String    @unique
  name              String    @default("")
  description       String    @default("")
  type              String    @default("PERCENTAGE")
  discountPercent   Float     @default(0)
  discountAmount    Float     @default(0)
  minPurchase       Float     @default(0)
  minQuantity       Int       @default(0)
  maxDiscountAmount Float     @default(0)
  maxUses           Int       @default(0)
  usedCount         Int       @default(0)
  usageLimit        Int       @default(0)
  usageLimitPerUser Int       @default(0)
  isActive          Boolean   @default(true)
  firstOrderOnly    Boolean   @default(false)
  startedAt         DateTime  @default(now())
  expiresAt         DateTime?
  createdById       String?
  createdBy         User?     @relation("CouponCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orders            Order[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([code])
  @@map("coupons")
}

// ==================== Shipment Model ====================
model Shipment {
  id                String    @id @default(cuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier           String
  trackingNumber    String
  status            String    @default("PENDING")
  shippingMethod    String    @default("standard")
  originAddress     String    @default("")
  destinationAddress String   @default("")
  weight            Float     @default(0)
  length            Float     @default(0)
  width             Float     @default(0)
  height            Float     @default(0)
  cost              Float     @default(0)
  currency          String    @default("USD")
  notes             String    @default("")
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  shippedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

// ==================== Notification Model ====================
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?     @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  type       String
  title      String
  message    String    @default("")
  link       String    @default("")
  actionUrl  String    @default("")
  imageUrl   String    @default("")
  channel    String    @default("in-app")
  category   String    @default("general")
  isRead     Boolean   @default(false)
  readAt     DateTime?
  seenAt     DateTime?
  deliveredAt DateTime?
  expiresAt  DateTime?
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ==================== Subscription Model ====================
model Subscription {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String
  status            String    @default("ACTIVE")
  startDate         DateTime
  endDate           DateTime?
  trialStartDate    DateTime?
  trialEndDate      DateTime?
  autoRenew         Boolean   @default(true)
  billingCycle      String    @default("monthly")
  paymentMethod     String    @default("")
  cancelledBy       String    @default("")
  cancellationReason String   @default("")
  cancelledAt       DateTime?
  lastBillingAt     DateTime?
  nextBillingAt     DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// ==================== Discount Model ====================
model Discount {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String
  code              String   @default("")
  description       String   @default("")
  type              String
  value             Float
  minQuantity       Int      @default(0)
  maxQuantity       Int      @default(0)
  minimumOrderAmount Float   @default(0)
  usageLimitPerUser Int      @default(0)
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean  @default(true)
  stackable         Boolean  @default(false)
  priority          Int      @default(0)
  maxUsage          Int      @default(0)
  usedCount         Int      @default(0)
  metadata          Json     @default("{}")
  createdById       String?
  createdBy         User?    @relation("DiscountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([productId])
  @@index([startDate, endDate])
  @@map("discounts")
}

// ==================== Conversation Model ====================
model Conversation {
  id                  String                    @id @default(cuid())
  title               String                    @default("")
  type                String                    @default("direct")
  lastMessageAt       DateTime?
  lastMessageContent  String                    @default("")
  lastMessageSenderId String                    @default("")
  isArchived          Boolean                   @default(false)
  isMuted             Boolean                   @default(false)
  participantCount    Int                       @default(0)
  metadata            Json                      @default("{}")
  participants        ConversationParticipant[]
  messages            Message[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@map("conversations")
}

// ==================== ConversationParticipant Model ====================
model ConversationParticipant {
  id                  String       @id @default(cuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname            String       @default("")
  role                String       @default("member")
  isMuted             Boolean      @default(false)
  notificationsEnabled Boolean     @default(true)
  pinnedAt            DateTime?
  lastReadAt          DateTime?
  joinedAt            DateTime     @default(now())

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

// ==================== Message Model ====================
model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content         String
  type            String       @default("text")
  parentId        String?
  parent          Message?     @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies         Message[]    @relation("MessageReplies")
  isRead          Boolean      @default(false)
  readAt          DateTime?
  deliveredAt     DateTime?
  editedAt        DateTime?
  attachments     Json         @default("[]")
  reactions       Json         @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([parentId])
  @@map("messages")
}

// ==================== Invoice Model ====================
model Invoice {
  id              String    @id @default(cuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber   String    @unique
  amount          Float
  subtotal        Float     @default(0)
  taxAmount       Float     @default(0)
  discountAmount  Float     @default(0)
  totalAmount     Float     @default(0)
  currency        String    @default("USD")
  status          String    @default("DRAFT")
  notes           String    @default("")
  billingAddress  String    @default("")
  shippingAddress String    @default("")
  pdfUrl          String    @default("")
  items           Json      @default("[]")
  issuedAt        DateTime  @default(now())
  dueDate         DateTime
  paidAt          DateTime?
  sentAt          DateTime?
  reminderSentAt  DateTime?
  cancelledAt     DateTime?
  cancelReason    String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("invoices")
}

// ==================== ReturnRequest Model ====================
model ReturnRequest {
  id               String    @id @default(cuid())
  orderItemId      String
  orderItem        OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason           String
  reasonDescription String   @default("")
  resolution       String    @default("")
  refundAmount     Float     @default(0)
  returnLabelUrl   String    @default("")
  condition        String    @default("")
  status           String    @default("PENDING")
  quantity         Int       @default(1)
  images           Json      @default("[]")
  requestedAt      DateTime  @default(now())
  pickedUpAt       DateTime?
  deliveredBackAt  DateTime?
  inspectedAt      DateTime?
  resolvedAt       DateTime?

  @@index([orderItemId])
  @@index([userId])
  @@index([status])
  @@map("return_requests")
}

// ==================== SupportTicket Model ====================
model SupportTicket {
  id String @id @default(cuid())

  userId String
  user   User   @relation("CreatedTickets", fields: [userId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedTickets", fields: [assignedToId], references: [id])

  escalatedToId String?
  escalatedTo   User?   @relation("EscalatedTickets", fields: [escalatedToId], references: [id])

  relatedOrderId  String?
  relatedTicketId String?
  relatedTicket   SupportTicket? @relation("RelatedTickets", fields: [relatedTicketId], references: [id], onDelete: SetNull)
  relatedTickets  SupportTicket[] @relation("RelatedTickets")

  subject     String
  description String

  status     String @default("OPEN")
  priority   String @default("MEDIUM")
  category   String @default("general")
  language   String @default("en")

  resolution      String @default("")
  escalationReason String @default("")
  satisfactionRating Int? @default(0)
  feedback         String @default("")
  tags             Json   @default("[]")

  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  replies TicketReply[]

  @@index([userId])
  @@index([assignedToId])
  @@index([escalatedToId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

// ==================== TicketReply Model ====================
model TicketReply {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  isStaff   Boolean       @default(false)
  isInternal Boolean      @default(false)
  isSolution Boolean      @default(false)
  attachments Json        @default("[]")
  editedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_replies")
}
