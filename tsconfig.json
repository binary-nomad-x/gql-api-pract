{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    /* Target & Environment */
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ESNext"
    ],
    "types": [
      "node"
    ], /* 'process' error ko fix karne ke liye */
    /* File Layout */
    "rootDir": "./",
    "outDir": "./dist",
    /* Output Quality */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    /* Interop & Modern Syntax */
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    /* Experimental (Prisma/GraphQL aksar decorators use karte hain) */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "include": [
    "src/**/*",
    "prisma.config.ts",
    ".env"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}